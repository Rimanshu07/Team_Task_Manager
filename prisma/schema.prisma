// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Workspace {
  id          String    @id @default(uuid())
  name        String
  inviteCode  String    @unique
  createdAt   DateTime  @default(now())
  users       User[]
  projects    Project[]
}

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  passwordHash  String
  role          String       @default("MEMBER") // ADMIN or MEMBER
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTasks Task[]       @relation("Assignee")
  createdTasks  Task[]       @relation("Creator")
  logs          ActivityLog[]
  createdAt     DateTime     @default(now())
}

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String    @default("ACTIVE") // ACTIVE, ARCHIVED, COMPLETED
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime  @default(now())
}

model Task {
  id          String      @id @default(uuid())
  title       String
  description String?
  status      String      @default("TODO") // TODO, IN_PROGRESS, DONE
  priority    String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?       @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId   String
  creator     User        @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String   // e.g., "CREATE_TASK", "UPDATE_STATUS", "CREATE_PROJECT"
  details   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
